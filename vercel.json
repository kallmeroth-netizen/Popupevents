{
  "rewrites": [
    {
      "source": "/t/:id",
      "destination": "/index.html"
    },
    {
      "source": "/menu",
      "destination": "/menu.html"
    },
    {
      "source": "/f/:id",
      "destination": "/survey.html"
    },
    {
      "source": "/cocktails",
      "destination": "/menu.html"
    },
    {
      "source": "/coffee",
      "destination": "/coffee.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/survey-cron",
      "schedule": "*/10 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "exclusivepreview.vercel.app"
        }
      ],
      "destination": "https://www.beneighborly.vip/$1",
      "permanent": false
    }
  ]
}
